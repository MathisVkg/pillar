# Dependencies
node_modules/

# Package manager / tool caches
.npm/
.yarn/
.pnpm-store/
.cache/

# Next.js
.next/
out/

# Production/build output
build/
dist/

# Test coverage
coverage/

# Environment variables
.env
.env.*
!.env.example
!.env.*.example

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma
# @pillar/database imports packages/database/generated/client directly, but the
# client is generated during local/deploy builds with `npm run db:generate`.
# Keep generated Prisma output and engine caches out of Git.
packages/database/generated/
packages/database/node_modules/.cache/prisma/
**/.prisma/client/
*.tmp
*.tmp.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS/editor files
.DS_Store
Thumbs.db

# Certificates/secrets
*.pem

# Optional local docs output
docs/
CLAUDE.md
