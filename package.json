{
  "name": "pillar-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/main",
    "build": "npm run build --workspace=apps/main",
    "dev:books": "npm run dev --workspace=apps/books",
    "build:books": "npm run build --workspace=apps/books"
  }
}
