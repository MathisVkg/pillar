{
  "name": "pillar-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/main",
    "build": "npm run build --workspace=apps/main",
    "dev:finpilot": "npm run dev --workspace=apps/finpilot",
    "build:finpilot": "npm run build --workspace=apps/finpilot"
  }
}
